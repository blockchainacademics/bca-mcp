{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.blockchainacademics/mcp",
  "description": "Cited crypto news, prices, onchain data, sentiment and indicators: 105 tools. Not financial advice.",
  "repository": {
    "url": "https://github.com/blockchainacademics/bca-mcp",
    "source": "github"
  },
  "version": "0.6.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@blockchainacademics/mcp",
      "version": "0.6.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BCA_API_KEY",
          "description": "Optional. When unset, the server uses a public demo key: 17 tools work under a shared daily cap. A free key (2,000 calls a month) opens 52 tools and paid plans open the rest: https://blockchainacademics.com/crypto-api/signup.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "BCA_API_BASE",
          "description": "Override the API base URL. Defaults to https://api.blockchainacademics.com.",
          "isRequired": false,
          "default": "https://api.blockchainacademics.com"
        }
      ]
    },
    {
      "registryType": "pypi",
      "identifier": "bca-mcp",
      "version": "0.6.4",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BCA_API_KEY",
          "description": "Optional. When unset, the server uses a public demo key: 17 tools work under a shared daily cap. A free key (2,000 calls a month) opens 52 tools and paid plans open the rest: https://blockchainacademics.com/crypto-api/signup.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "BCA_API_BASE",
          "description": "Override the API base URL. Defaults to https://api.blockchainacademics.com.",
          "isRequired": false,
          "default": "https://api.blockchainacademics.com"
        }
      ]
    }
  ],
