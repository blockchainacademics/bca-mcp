{
  "name": "@blockchainacademics/mcp",
  "version": "0.6.4",
  "description": "Crypto MCP server for AI agents: cited news, prices, onchain data, sentiment and indicators. 105 tools, 17 work without a key, and every answer carries its sources and a completeness status.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bca-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "tools.json"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "gen:demo-key": "node scripts/gen-demo-key.mjs",
    "build": "npm run gen:demo-key && tsc && npm run gen:tools-json",
    "dev": "npm run gen:demo-key && tsx src/index.ts",
    "test": "npm run gen:demo-key && node --test --import=tsx test/*.test.ts",
    "prepublishOnly": "npm run build && npm run version:check && npm test",
    "version:check": "node scripts/version-check.mjs",
    "gen:tools-json": "node scripts/gen-tools-json.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crypto",
    "blockchain",
    "ai-agents",
    "claude",
    "anthropic",
    "blockchainacademics"
  ],
  "author": "Blockchain Academics <hello@blockchainacademics.com>",
  "license": "MIT",
  "homepage": "https://github.com/blockchainacademics/bca-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blockchainacademics/bca-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/blockchainacademics/bca-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  },
  "overrides": {
    "fast-uri": "^3.1.9"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "mcpName": "io.github.blockchainacademics/mcp"
}
